{
  "expo": {
    "name": "Ligtas Calbayog - Police",
    "slug": "police-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/iconlogo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ligtas.police",
      "icon": "./assets/iconlogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconlogo.png",
        "backgroundColor": "#17202b"
      },
      "package": "com.ligtas.police",
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-av",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-police.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#001A4D"
        }
      ]
    ],
    "scheme": "ligtas-police"
  }
}
