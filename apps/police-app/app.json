{
  "expo": {
    "name": "Ligtas Calbayog - Police",
    "slug": "police-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/iconlogo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ligtas.police",
      "icon": "./assets/iconlogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconlogo.png",
        "backgroundColor": "#17202b"
      },
      "package": "com.ligtas.police",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-av",
      "expo-image-picker",
      "expo-haptics",
      "expo-file-system",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-police.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#001A4D"
        }
      ]
    ],
    "scheme": "ligtas-police",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c683ad1e-3a6b-4ec4-9640-87141742f769"
      }
    }
  }
}
