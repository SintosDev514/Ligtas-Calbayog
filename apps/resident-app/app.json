{
  "expo": {
    "name": "resident-app",
    "slug": "resident-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconlogo.png",
    "scheme": "residentapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ligtascalbayog.residentapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to verify your identity during registration.",
        "NSLocationWhenInUseUsageDescription": "Your location is used to attach to crime reports so police can respond faster."
      }
    },
    "android": {
      "package": "com.ligtascalbayog.residentapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ligtas Calbayog to access your location to include it in crime reports."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cba7f3f8-bc52-42fd-bdac-de773d97f71c"
      }
    }
  }
}
